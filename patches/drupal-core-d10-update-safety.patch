 use Drupal\views\ViewsConfigUpdater;
 
 /**
+ * Safely runs a Views config updater across view config entities.
+ */
+function _views_safe_config_update(?array &$sandbox, callable $callback): void {
+  \Drupal::classResolver(ConfigEntityUpdater::class)->update($sandbox, 'view', function (ViewEntityInterface $view) use ($callback): bool {
+    try {
+      return (bool) $callback($view);
+    }
+    catch (\Throwable $e) {
+      \Drupal::logger('views')->warning('Skipped Views post-update for view @view because it could not be updated cleanly: @message', [
+        '@view' => $view->id(),
+        '@message' => $e->getMessage(),
+      ]);
+      return FALSE;
+    }
+  }, TRUE);
+}
+
