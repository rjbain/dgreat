diff --git a/src/Access/NullGroupPermissionCalculator.php b/src/Access/NullGroupPermissionCalculator.php
--- /dev/null
+++ b/src/Access/NullGroupPermissionCalculator.php
@@ -0,0 +1,21 @@
+<?php
+
+namespace Drupal\group\Access;
+
+use Drupal\Core\Session\AccountInterface;
+use Drupal\Core\Session\CalculatedPermissions;
+use Drupal\Core\Session\RefinableCalculatedPermissions;
+
+/**
+ * Fallback group permission calculator for broken upgrade bootstrap states.
+ */
+class NullGroupPermissionCalculator implements GroupPermissionCalculatorInterface {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function calculateFullPermissions(AccountInterface $account) {
+    return new CalculatedPermissions(new RefinableCalculatedPermissions());
+  }
+
+}
