<?php

/**
 * @file
 * Contains dgreat_nodes.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Form\FormStateInterface;


/**
 * Implements hook_help().
 */
function dgreat_nodes_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the dgreat_nodes module.
    case 'help.page.dgreat_nodes':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Custom functions related to nodes on the site.') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_entity_bundle_field_info_alter().
 *
 * Attaches a validation constraint to bp_column_content on bp_columns
 * paragraphs so editors cannot save more than 3 column items.
 */
function dgreat_nodes_entity_bundle_field_info_alter(&$fields, \Drupal\Core\Entity\EntityTypeInterface $entity_type, $bundle) {
  if ($entity_type->id() === 'paragraph'
    && $bundle === 'bp_columns'
    && isset($fields['bp_column_content'])) {
    $fields['bp_column_content']->addConstraint('BpColumnsMaxItems', ['max' => 3]);
  }
}

/**
 * Implements hook_field_widget_complete_form_alter().
 *
 * Replaces the add-more control with a message when bp_columns already has
 * the maximum number of column items.
 */
function dgreat_nodes_field_widget_complete_form_alter(&$field_widget_complete_form, FormStateInterface $form_state, array $context) {
  if (empty($context['items']) || !method_exists($context['items'], 'getFieldDefinition')) {
    return;
  }

  /** @var \Drupal\Core\Field\FieldDefinitionInterface $field_definition */
  $field_definition = $context['items']->getFieldDefinition();
  if ($field_definition->getName() !== 'bp_column_content') {
    return;
  }

  $widget = &$field_widget_complete_form['widget'];
  $item_count = count(array_filter(array_keys($widget), 'is_int'));

  if ($item_count >= 3) {
    $widget['add_more'] = [
      '#type' => 'html_tag',
      '#tag' => 'p',
      '#value' => t('The maximum of 3 column items has been reached. To change the column structure, please remove an existing item first.'),
      '#attributes' => [
        'class' => ['bp-columns-limit-reached'],
        'style' => 'color: red;',
      ],
    ];
  }
}

/**
 * Implements hook_form_alter().
 */
function dgreat_nodes_form_alter(&$form, FormStateInterface $form_state, $form_id) {

  if (_dgreat_nodes_form_has_paragraphs_widget($form) || _dgreat_nodes_form_has_text_format_widget($form)) {
    $form['#attached']['library'][] = 'dgreat_nodes/paragraphs_editor_admin';
  }

  $fav_links_nodes = [
    'node_favorite_link_form',
    'node_favorite_link_edit_form'
  ];


  if (in_array($form_id, $fav_links_nodes)) {

    $query = \Drupal::request()->query->get('edit');
    if (!is_array($query)) {
      $query = [];
    }

    if (isset($query['field_link_type']['und']) && is_scalar($query['field_link_type']['und'])) {
      $form['field_link_type']['widget']['#default_value'] = $query['field_link_type']['und'];
    }

    $user = \Drupal::currentUser()->getRoles();
    if (!in_array('administrator', $user)) {
      unset($form['field_link_type']['widget']['#options']['favorite']);
      $form['field_top_quick_link']['#access'] = FALSE;
      $form['field_group_audience']['#access'] = FALSE;
    }
  }
}

/**
 * Implements hook_page_attachments().
 */
function dgreat_nodes_page_attachments(array &$attachments) {
  if (\Drupal::currentUser()->hasPermission('access toolbar')) {
    $attachments['#attached']['library'][] = 'dgreat_nodes/admin_overrides';
  }
}

/**
 * Checks whether a form contains a paragraphs widget.
 */
function _dgreat_nodes_form_has_paragraphs_widget(array $element) {
  if (!empty($element['#inline_paragraphs_widget'])) {
    return TRUE;
  }

  if (!empty($element['#field_widget']) && $element['#field_widget'] === 'entity_reference_paragraphs') {
    return TRUE;
  }

  if (!empty($element['#attributes']['class']) && in_array('field--widget-paragraphs', $element['#attributes']['class'], TRUE)) {
    return TRUE;
  }

  foreach ($element as $key => $child) {
    if (is_string($key) && $key !== '' && $key[0] === '#') {
      continue;
    }

    if (is_array($child) && _dgreat_nodes_form_has_paragraphs_widget($child)) {
      return TRUE;
    }
  }

  return FALSE;
}

/**
 * Checks whether a form contains a text format widget.
 */
function _dgreat_nodes_form_has_text_format_widget(array $element) {
  if (!empty($element['#type']) && $element['#type'] === 'text_format') {
    return TRUE;
  }

  foreach ($element as $key => $child) {
    if (is_string($key) && $key !== '' && $key[0] === '#') {
      continue;
    }

    if (is_array($child) && _dgreat_nodes_form_has_text_format_widget($child)) {
      return TRUE;
    }
  }

  return FALSE;
}
