<?php

/**
 * @file
 * Contains dgreat_views.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\views\ViewExecutable;
use Drupal\user\Entity\User;
use Drupal\Core\Entity\EntityInterface;
use Drupal\views\Form\ViewsForm;
use Drupal\node\Entity\Node;

/**
 * Implements hook_help().
 */
function dgreat_views_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the dgreat_views module.
    case 'help.page.dgreat_views':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Custom code related to the views on the site.') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 */
function dgreat_views_flagging_insert(EntityInterface $entity) {
  _dgreat_views_adjust_flag_entities($entity, TRUE);
}

/**
 * Implements hook_ENTITY_TYPE_delete().
 */
function dgreat_views_flagging_delete(EntityInterface $entity) {
  _dgreat_views_adjust_flag_entities($entity, FALSE);
}

/**
 * Implements hook_views_data().
 */
function dgreat_views_views_data() {

  $data['user_weights']['table']['group'] = t('User Weights');
  $data['user_weights']['table']['base'] = [
    'field' => 'entity_id',
    'title' => t('User Weights'),
  ];

  $data['user_weights']['table']['join']['node_field_data'] = [
    'left_field' => 'nid',
    'field' => 'entity_id',
  ];

  return $data;
}

/**
 * Implements hook_views_data_alter().
 */
function dgreat_views_views_data_alter(array &$data) {
  $data['node_field_data']['dgreat_flag_relationship'] = [
    'title' => t('Quick Link Special Flag Relationship'),
    'help' => t('Alters view based off user role and what is seen.'),
    'relationship' => [
      'group' => t('Flag'),
      'label' => t('Flags'),
      'base' => 'flagging',
      'base field' => 'entity_id',
      'relationship field' => 'nid',
      'id' => 'dgreat_flag_relationship',
      'flaggable' => 'node',
    ],
  ];

  $desc = t('Filters Quick Links based off of user.');
  $data['node_field_data']['user_filter'] = [
    'title' => t('Filter by User'),
    'filter' => [
      'title' => t('Filter by User'),
      'help' => $desc,
      'field' => 'nid',
      'id' => 'dgreat_views_filter_by_user'
    ],
  ];

  $desc = t('Check User Weights and sorts by title asc if there are none.');
  $data['node_field_data']['user_weights'] = [
    'title' => t('Check User Weights'),
    'filter' => [
      'title' => t('Check User Weights'),
      'help' => $desc,
      'field' => 'nid',
      'id' => 'user_weight_filter_sort'
    ],
  ];

  // This overrides the existing weights views field.
  // If for some reason you try to add weights to another view
  // And the js isn't kicking in.  Comment this out, remove and readd the weight field
  // And then uncomment this, will fix your issue.
  $data['node__field_weight']['field_weight']['field']['id'] = 'custom_weight_selector';
}

/**
 * Implements hook_views_pre_view().
 */
function dgreat_views_views_pre_view(ViewExecutable $view, $display_id, array &$args) {
  $name = $view->id();
  $display = $view->current_display;

  if ($display === 'all_apps' && in_array($name, ['quick_links', 'favorite_links'], TRUE)) {
    _dgreat_views_sync_flaggings_from_weights(\Drupal::currentUser()->id(), $name);
  }

  switch ($name) {
    case 'favorite_links':

      // Removes fields and header for non admins.
      if ($display == 'all_apps') {
        $user_roles = \Drupal::currentUser()->getRoles();
        if (!in_array('administrator', $user_roles)) {
          $view->removeHandler($display, 'field', 'field_group_audience');
          $view->removeHandler($display, 'field', 'edit_node');
          $view->removeHandler($display, 'field', 'delete_node');
          $view->removeHandler($display, 'header', 'area');

        }
      }
      break;

    case 'quick_links':
      // Removes fields and header for non admins.
      if ($display == 'all_apps') {
        $user_roles = \Drupal::currentUser()->getRoles();
        if (!in_array('administrator', $user_roles)) {
          $view->removeHandler($display, 'field', 'body');
          $view->removeHandler($display, 'field', 'field_category');
          $view->removeHandler($display, 'field', 'field_sso');
          $view->removeHandler($display, 'field', 'field_group_audience');
          $view->removeHandler($display, 'field', 'edit_node');
          $view->removeHandler($display, 'field', 'delete_node');
        }

        if (in_array('administrator', $user_roles)) {
          $view->removeHandler($display, 'filter', 'user_filter');
        }
      }
      break;
  }
}

/**
 * Implements hook_views_query_alter().
 */
function dgreat_views_views_query_alter(ViewExecutable $view, $query) {
  if ($view->id() !== 'quick_links' || $view->current_display !== 'all_apps') {
    return;
  }

  $uid = \Drupal::currentUser()->id();
  if (!$uid) {
    $query->addWhereExpression(0, '1 = 0');
    return;
  }

  $rows = \Drupal::database()->select('user_weights', 'u')
    ->fields('u', ['entity_id'])
    ->condition('uid', $uid)
    ->condition('view_name', 'quick_links_history')
    ->orderBy('weight', 'ASC')
    ->execute()
    ->fetchCol();

  $history_nids = array_values(array_unique(array_map('intval', $rows)));
  if (empty($history_nids)) {
    $query->addWhereExpression(0, '1 = 0');
    return;
  }

  $active_rows = \Drupal::database()->select('user_weights', 'u')
    ->fields('u', ['entity_id'])
    ->condition('uid', $uid)
    ->condition('view_name', 'quick_links')
    ->condition('entity_id', $history_nids, 'IN')
    ->execute()
    ->fetchCol();

  $active_nids = array_values(array_unique(array_map('intval', $active_rows)));
  $nids = array_values(array_diff($history_nids, $active_nids));
  if (empty($nids)) {
    $query->addWhereExpression(0, '1 = 0');
    return;
  }

  $query->addWhere(0, 'node_field_data_group_relationship_field_data.nid', $nids, 'IN');
}

/**
 * Ensures dashboard links tracked in user_weights also have a favorite flag.
 *
 * @param int $uid
 *   The user ID.
 * @param string $view_name
 *   The view_name stored in user_weights.
 */
function _dgreat_views_sync_flaggings_from_weights(int $uid, string $view_name): void {
  if (!$uid) {
    return;
  }

  $db = \Drupal::database();
  $nids = $db->select('user_weights', 'u')
    ->fields('u', ['entity_id'])
    ->condition('uid', $uid)
    ->condition('view_name', $view_name)
    ->execute()
    ->fetchCol();

  if (empty($nids)) {
    return;
  }

  $existing = $db->select('flagging', 'f')
    ->fields('f', ['entity_id'])
    ->condition('uid', $uid)
    ->condition('flag_id', 'favorite')
    ->condition('entity_type', 'node')
    ->condition('entity_id', $nids, 'IN')
    ->execute()
    ->fetchCol();

  $missing = array_diff($nids, $existing);
  if (empty($missing)) {
    return;
  }

  $storage = \Drupal::entityTypeManager()->getStorage('flagging');
  foreach ($missing as $nid) {
    $node = Node::load($nid);
    if (!$node) {
      continue;
    }

    $flagging = $storage->create([
      'uid' => $uid,
      'session_id' => NULL,
      'flag_id' => 'favorite',
      'entity_id' => $nid,
      'entity_type' => $node->getEntityTypeId(),
      'global' => 0,
    ]);
    $flagging->save();
  }
}

/**
 * Implements hook_views_pre_render().
 */
function dgreat_views_views_pre_render(ViewExecutable $view) {
  $name = $view->id();
  $display = $view->current_display;

  // Removes the duplicates from the Group Content View.
  switch ($name) {
    case 'favorite_links':
    case 'favorite_links_quick_menu':
    case 'quick_links':

      $view->result = _dgreat_views_remove_duplicates($view->result);

      // Quick Links "All Links" should not show the entire system catalog.
      // It should only show links this user has added before, including links
      // they later removed from the dashboard.
      if ($display === 'all_apps' && $name === 'quick_links') {
        $uid = \Drupal::currentUser()->id();
        $db = \Drupal::database();
        $rows = $db->select('user_weights', 'u')
          ->fields('u', ['entity_id', 'weight'])
          ->condition('uid', $uid)
          ->condition('view_name', 'quick_links_history')
          ->orderBy('weight', 'ASC')
          ->execute()
          ->fetchAll();

        if (empty($rows)) {
          $view->result = [];
          return;
        }

        $historical_nids = array_map(static fn($row) => (int) $row->entity_id, $rows);
        $historical_weights = [];
        foreach ($rows as $row) {
          $historical_weights[(int) $row->entity_id] = (int) $row->weight;
        }

        $filtered_results = [];
        foreach ($view->result as $result) {
          $nid = (int) $result->node_field_data_group_relationship_field_data_nid;
          if (in_array($nid, $historical_nids, TRUE)) {
            $filtered_results[] = $result;
          }
        }

        usort($filtered_results, static function ($a, $b) use ($historical_weights) {
          $a_nid = (int) $a->node_field_data_group_relationship_field_data_nid;
          $b_nid = (int) $b->node_field_data_group_relationship_field_data_nid;
          return ($historical_weights[$a_nid] ?? PHP_INT_MAX) <=> ($historical_weights[$b_nid] ?? PHP_INT_MAX);
        });

        $view->result = $filtered_results;
        $view->total_rows = count($filtered_results);
        if (isset($view->pager)) {
          $view->pager->total_items = count($filtered_results);
          $view->pager->updatePageInfo();
        }
        return;
      }

      if ($display === 'all_apps' && $name === 'favorite_links') {
        return;
      }

      // Adds in the default links for my_links displays.
      $results = _dgreat_views_apply_defaults($view->result, $name);
      if ($results !== NULL) {
        $view->result = $results;
      }
      else {
        return;
      }

      // Sorts our user weights items for proper display.
      // Only place I could get this to work right.
      // Normal sort won't work since we have to do it by user.

      // Initialize the db.
      $db = \Drupal::database();

      // Grab the count first to make sure we have rows to manipulate.
      $uid = \Drupal::currentUser()->id();
      $rows = $db
        ->select('user_weights', 'u')
        ->fields('u', ['entity_id'])
        ->condition('uid', $uid)
        ->condition('view_name', $name)
        ->execute()
        ->fetchAll();
      $count = count($rows);

      if ($count && isset($view->result)) {
        $new_results = [];

        foreach ($view->result as $result) {
          $nid = $result->node_field_data_group_relationship_field_data_nid;

          $weight = $db->select('user_weights', 'u')
            ->fields('u', ['weight'])
            ->condition('uid', $uid)
            ->condition('entity_id', $nid)
            ->condition('view_name', $name)
            ->execute()
            ->fetchField();

          $new_results[$weight] = $result;
        }

        ksort($new_results);
        $new_results = array_values(array_filter($new_results));
        $view->result = $new_results;
      }
      else {
        // Personal link views should only display links the user explicitly
        // added. If there are no saved user_weights rows yet, do not seed the
        // entire current result set into the user's dashboard.
        $view->result = [];
      }

      break;
  }
}

/**
 * Helper function to remove duplicates from the view.
 *
 * @param $results
 *   The views object of ResultRow items.
 *
 * @return array
 */
function _dgreat_views_remove_duplicates($results) {
  $new_results = $unique_nids = [];

  // Cycle through and remove duplicates.
  foreach ($results as $index => $result) {
    // Grab the nid from the related node.
    $node = $result->_relationship_entities['gc__node'];
    $nid = $node->id();

    // If it isn;t in there, add it and the result.
    if (!in_array($nid, $unique_nids)) {
      $unique_nids[] = $nid;
      $new_results[] = $result;
    }
  }

  return $new_results;
}

/**
 * Helper function to apply defaults to the view.
 *
 * @param $results
 *   The views object of ResultRow items.
 * @param $name
 *   The view name.
 *
 * @return array
 */
function _dgreat_views_apply_defaults($results, $name) {

  // Initialize our vars.
  $gids = $nids = $nodes = $defaults = $view_results = $view_result_nids = [];
  $query = NULL;

  // Grab the existing results to store later.
  // So we can put that after the defaults.
  foreach ($results as $index => $result) {
    $view_results[] = $result;
    if (isset($result->node_field_data_group_relationship_field_data_nid)) {
      $view_result_nids[] = $result->node_field_data_group_relationship_field_data_nid;
    }
  }

  // Grab the current users groups.
  $uid = \Drupal::currentUser()->id();
  $user = User::load($uid);
  $groups = $user->get('field_user_group')->getValue();
  foreach ($groups as $gid) {
    $gids[] = $gid['target_id'];
  }

  if (empty($gids)) {
    return NULL;
  }

  // Remove duplicates.
  $gids = array_unique($gids);

  // Initialize the db.
  $db = \Drupal::database();

  // Grab all the default entity ids of the group.
  if (in_array($name, ['favorite_links', 'quick_links'], TRUE)) {
    // Favorite and quick links should reflect the user's current add/remove
    // choices. Group defaults may seed the initial flag/user_weight records
    // elsewhere, but they should not be forced back onto the dashboard after
    // removal.
    $query = NULL;
  }

  // Loop through and grab our content ids.
  if ($query) {
    foreach ($query->execute()->fetchAll() as $result) {
      if ($name == 'favorite_links') {
        $nids[] = $result->field_default_favorite_links_target_id;
      }
      if ($name == 'quick_links') {
        $nids[] = $result->field_default_quick_links_target_id;
      }
    }
  }

  $view_result_nids = array_unique(array_filter($view_result_nids));

  if (empty($nids) && empty($view_result_nids)) {
    return NULL;
  }

  // Remove duplicates.
  $nids = array_unique($nids);

  if (!empty($view_result_nids)) {
    // Keep links the user explicitly added or ordered on this view.
    $weighted_nids = $db
      ->select('user_weights', 'u')
      ->fields('u', ['entity_id'])
      ->condition('entity_id', $view_result_nids, 'IN')
      ->condition('uid', $uid)
      ->condition('view_name', $name)
      ->execute()
      ->fetchCol();
    $nids = array_merge($nids, $weighted_nids);
  }

  // Check against the user's flagged items across the current view results.
  if (!empty($view_result_nids)) {
    $query = $db
      ->select('flagging', 'f')
      ->fields('f', ['entity_id'])
      ->condition('entity_id', $view_result_nids, 'IN')
      ->condition('uid', $uid);

    // Flatten on the nids to check against.
    foreach ($query->execute()->fetchAll() as $nid) {
      $nids[] = $nid->entity_id;
    }
  }

  $nids = array_unique($nids);

  // Check for the defaults in the loaded array.
  foreach ($view_results as $key => $result) {
    $check = $result->node_field_data_group_relationship_field_data_nid;
    if (in_array($check, $nids)) {
      $defaults[] = $result;
    }
  }

  if (in_array($name, ['favorite_links', 'quick_links'], TRUE)) {
    return _dgreat_views_remove_duplicates($defaults);
  }

  // Merge the results setting defaults on top.
  $merge = array_merge_recursive($defaults, $view_results);
  $results = _dgreat_views_remove_duplicates($merge);
  return $results;
}

/**
 * Helper function update the user weights table for flagged entities.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity being flagged or unflagged.
 * @param bool $is_flagged
 *   TRUE when a flag is being created, FALSE when it is being removed.
 */
function _dgreat_views_adjust_flag_entities(EntityInterface $entity, bool $is_flagged) {
  $nid = $entity->get('entity_id')->getValue();
  $uid = $entity->get('uid')->getValue();

  \Drupal::state()->set('flagged_fav', $is_flagged);

  if (isset($nid[0]["value"]) && isset($uid[0]["target_id"])) {
    $db = \Drupal::database();
    $account_id = (int) $uid[0]["target_id"];
    $entity_id = (int) $nid[0]["value"];
    $node = Node::load($entity_id);

    // Quick-link dashboard add/remove actions are driven by flagging, but the
    // flag links do not consistently carry a destination query parameter.
    // Detect quick-link nodes directly so we always maintain the active
    // dashboard rows and the persistent all-apps history rows.
    if ($node && $node->bundle() === 'favorite_link' && $node->hasField('field_link_type')) {
      $link_type = $node->get('field_link_type')->value;

      if ($link_type === 'quick') {
        $check = $db
          ->select('user_weights', 'u')
          ->fields('u', ['entity_id'])
          ->condition('uid', $account_id)
          ->condition('entity_id', $entity_id)
          ->condition('view_name', 'quick_links')
          ->execute()
          ->fetchField();

        $history_check = $db
          ->select('user_weights', 'u')
          ->fields('u', ['entity_id'])
          ->condition('uid', $account_id)
          ->condition('entity_id', $entity_id)
          ->condition('view_name', 'quick_links_history')
          ->execute()
          ->fetchField();

        $weight = (int) $db
          ->query("SELECT COALESCE(MAX(weight), 0) FROM {user_weights} WHERE uid = :uid", [':uid' => $account_id])
          ->fetchField();

        if ($is_flagged) {
          if ($check === FALSE) {
            $db->insert('user_weights')
              ->fields([
                'entity_id' => $entity_id,
                'uid' => $account_id,
                'view_name' => 'quick_links',
                'weight' => $weight + 1,
              ])
              ->execute();
          }

          if ($history_check === FALSE) {
            $db->insert('user_weights')
              ->fields([
                'entity_id' => $entity_id,
                'uid' => $account_id,
                'view_name' => 'quick_links_history',
                'weight' => $weight + 1,
              ])
              ->execute();
          }
        }
        else {
          if ($history_check === FALSE) {
            $db->insert('user_weights')
              ->fields([
                'entity_id' => $entity_id,
                'uid' => $account_id,
                'view_name' => 'quick_links_history',
                'weight' => $weight + 1,
              ])
              ->execute();
          }

          $db->delete('user_weights')
            ->condition('uid', $account_id)
            ->condition('entity_id', $entity_id)
            ->condition('view_name', 'quick_links')
            ->execute();
        }
      }
    }

    // Need to use the $_GET params here since we are within the flagging
    // mechanisms and can;t get proper routes otherwise.
    $current_path = isset($_GET["destination"]) ? $_GET["destination"] : NULL;
    if ($current_path !== NULL) {
      $url_object = \Drupal::service('path.validator')->getUrlIfValid($current_path);
      $route_name = $url_object->getRouteName();

      $view_get = explode('.', $route_name);
      $name = isset($view_get[1]) ? $view_get[1] : '';

      if (!empty($name)) {
        $check = $db
          ->select('user_weights', 'u')
          ->fields('u', ['entity_id'])
          ->condition('uid', $uid[0]["target_id"])
          ->condition('entity_id', $nid[0]["value"])
          ->condition('view_name', $name)
          ->execute()
          ->fetchField();

        // Grab the new weight.
        $sql = "SELECT MAX(weight) FROM {user_weights} WHERE uid = :uid";
        $weight = $db
          ->query($sql, [':uid' => $uid[0]["target_id"]])
          ->fetchField();

        if ($is_flagged) {
          if ($check === FALSE) {
            // Insert new item in weights table.
            $db->insert('user_weights')
              ->fields([
                'entity_id' => $nid[0]["value"],
                'uid' => $uid[0]["target_id"],
                'view_name' => $name,
                'weight' => $weight + 1,
              ])
              ->execute();
          }
          else {
            // Update the weights table.
            $db->update('user_weights')
              ->condition('uid', $uid[0]["target_id"])
              ->condition('entity_id', $nid[0]["value"])
              ->condition('view_name', $name)
              ->fields([
                'entity_id' => $nid[0]["value"],
                'uid' => $uid[0]["target_id"],
                'view_name' => $name,
                'weight' => $weight + 1,
              ])
              ->execute();
          }

          // Keep a persistent history row so /quick-links/allapps can show
          // links the user removed and let them add those links back later.
          $history_check = $db
            ->select('user_weights', 'u')
            ->fields('u', ['entity_id'])
            ->condition('uid', $uid[0]["target_id"])
            ->condition('entity_id', $nid[0]["value"])
            ->condition('view_name', 'quick_links_history')
            ->execute()
            ->fetchField();

          if ($history_check === FALSE) {
            $db->insert('user_weights')
              ->fields([
                'entity_id' => $nid[0]["value"],
                'uid' => $uid[0]["target_id"],
                'view_name' => 'quick_links_history',
                'weight' => $weight + 1,
              ])
              ->execute();
          }
        }
        elseif ($check !== FALSE) {
          // Preserve a persistent history row so removed quick links can be
          // shown on /quick-links/allapps and added back later, even if the
          // link predates the dedicated history tracking.
          $history_check = $db
            ->select('user_weights', 'u')
            ->fields('u', ['entity_id'])
            ->condition('uid', $uid[0]["target_id"])
            ->condition('entity_id', $nid[0]["value"])
            ->condition('view_name', 'quick_links_history')
            ->execute()
            ->fetchField();

          if ($name === 'quick_links' && $history_check === FALSE) {
            $db->insert('user_weights')
              ->fields([
                'entity_id' => $nid[0]["value"],
                'uid' => $uid[0]["target_id"],
                'view_name' => 'quick_links_history',
                'weight' => $weight + 1,
              ])
              ->execute();
          }

          // Remove the link from the user's ordered list when it is unflagged.
          $db->delete('user_weights')
            ->condition('uid', $uid[0]["target_id"])
            ->condition('entity_id', $nid[0]["value"])
            ->condition('view_name', $name)
            ->execute();
        }
      }
    }
  }
}
