<?php

/**
 * @file
 * Contains dgreat_group.module.
 */

use Drupal\user\Entity\User;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\dgreat_group\DgreatGroup;
use Drupal\dgreat_group\DgreatGroupUtility;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\dgreat_group\RoleGroupMapperService;
use Drupal\Core\Access\AccessResult;
use Drupal\Core\Session\AccountInterface;
use Drupal\group\Entity\GroupRelationshipInterface;
use Drupal\group\Entity\GroupInterface;
use Drupal\node\Entity\Node;
use Drupal\Core\Entity\EntityTypeInterface;

/**
 * Implements hook_help().
 */
function dgreat_group_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the dgreat_group module.
    case 'help.page.dgreat_group':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Custom module needed for the workflows of group nodes/users') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 *
 * Adds a node to the respective group identified.
 */
function dgreat_group_node_insert(EntityInterface $entity) {
  switch ($entity->bundle()) {
    case 'favorite_link':
      $quick = (new DgreatGroup($entity))->finalizeQuickLinkGroups();
      $add = (new DgreatGroup($entity))->addNodeToGroup('field_group_audience');
      break;

    case 'usf_service':
      $add = (new DgreatGroup($entity))->addNodeToGroup('field_usfcat_audience_ref');
      break;
  }
}

/**
 * Implements hook_ENTITY_TYPE_presave().
 *
 * Prepares favorite link data before the initial save occurs.
 */
function dgreat_group_node_presave(EntityInterface $entity) {
  if ($entity->getEntityTypeId() !== 'node' || $entity->bundle() !== 'favorite_link') {
    return;
  }

  (new DgreatGroup($entity))->prepareQuickLinkGroups();
}

/**
 * Implements hook_ENTITY_TYPE_update().
 *
 * Adds a node to the respective group identified.
 */
function dgreat_group_node_update(EntityInterface $entity) {
  switch ($entity->bundle()) {
    case 'favorite_link':
      $add = (new DgreatGroup($entity))->addNodeToGroup('field_group_audience');
      break;

    case 'usf_service':
      $add = (new DgreatGroup($entity))->addNodeToGroup('field_usfcat_audience_ref');
      break;
  }
}

/**
 * Implements hook_user_login().
 */
function dgreat_group_user_login($account) {
  // If the user has a role that is mapped to a group,
  // Add them to that group.
  /** @var RoleGroupMapperService $mapper */
  $mapper = \Drupal::service('dgreat_group.role_mapper');
  $mapper->reconcileGroupAccess($account);
}

/**
 * Implements hook_ENTITY_TYPE_insert().
 */
function dgreat_group_user_insert(EntityInterface $entity) {
  (new DgreatGroup($entity))->flagUserDefaultContent($entity);
}

/**
 * Implements hook_ENTITY_TYPE_update().
 */
function dgreat_group_user_update(User $entity) {
  (new DgreatGroup($entity))->flagUserDefaultContent($entity);
}

/**
 * Implements hook_entity_access().
 */
function dgreat_group_entity_access(EntityInterface $entity, $operation, AccountInterface $account) {
  if ($entity instanceof GroupRelationshipInterface) {
    if (in_array($operation, ['view', 'update'], TRUE) && in_array('administrator', $account->getRoles(), TRUE)) {
      return AccessResult::allowed()->cachePerPermissions();
    }

    return AccessResult::neutral();
  }

  if (!$entity instanceof GroupInterface) {
    return AccessResult::neutral();
  }

  if (!in_array($operation, ['view', 'update', 'delete'], TRUE)) {
    return AccessResult::neutral();
  }

  if (in_array('administrator', $account->getRoles(), TRUE)) {
    return AccessResult::allowed()->cachePerPermissions();
  }

  return AccessResult::neutral();
}

/**
 * Implements hook_group_relationship_insert().
 */
function dgreat_group_group_relationship_insert(GroupRelationshipInterface $entity) {
  $dgreat_group_user = $entity->getEntity();

  if (!$dgreat_group_user instanceof User) {
    return;
  }

  $group = $entity->getGroup();

  // Space creators need an explicit group role or they cannot see their own
  // newly-created group in access-checked listings like /admin/group.
  if ($group->bundle() === 'spaces' && (int) $group->getOwnerId() === (int) $dgreat_group_user->id()) {
    $membership = $group->getMember($dgreat_group_user);
    if ($membership) {
      $role_ids = array_map(fn($role) => $role->id(), $membership->getRoles());
      if (!in_array('spaces-administrator', $role_ids, TRUE)) {
        $membership->addRole('spaces-administrator');
        $membership->getGroupRelationship()->save();
      }
    }
  }

  /** @var \Drupal\dgreat_group\RoleGroupMapperService $mapper */
  $mapper = \Drupal::service('dgreat_group.role_mapper');
  $mapper->ensureUserHasGroupField($dgreat_group_user, (string) $group->id());
}

/**
 * Implements hook_group_relationship_delete().
 */
function dgreat_group_group_relationship_delete(GroupRelationshipInterface $entity) {
  $dgreat_group_user = $entity->getEntity();

  if (!$dgreat_group_user instanceof User) {
    return;
  }

  /** @var \Drupal\dgreat_group\RoleGroupMapperService $mapper */
  $mapper = \Drupal::service('dgreat_group.role_mapper');
  $mapper->removeGroupFieldFromUser($dgreat_group_user, (string) $entity->getGroup()->id());
}

/**
 * Implements hook_entity_type_alter().
 */
function dgreat_group_entity_type_alter(array &$entity_types) {
  if (isset($entity_types['group']) && $entity_types['group'] instanceof EntityTypeInterface) {
    $entity_types['group']->setListBuilderClass('Drupal\\dgreat_group\\Entity\\Controller\\EditorScopedGroupListBuilder');
  }

  if (isset($entity_types['group_relationship']) && $entity_types['group_relationship'] instanceof EntityTypeInterface) {
    $entity_types['group_relationship']->setListBuilderClass('Drupal\\dgreat_group\\Entity\\Controller\\AdministratorGroupRelationshipListBuilder');
  }
}
