<?php

/**
 * @file
 * Update hooks for the dgreat_group module.
 */

/**
 * Marks upgraded Group relationship type IDs as legacy-compatible.
 */
function dgreat_group_update_8101() {
  \Drupal::state()->set('group_update_10300_detected_legacy_version', TRUE);

  return t('Enabled legacy Group relationship type ID lookups for upgraded group content plugins.');
}

/**
 * Backfills missing group membership roles for groups and spaces.
 */
function dgreat_group_update_8104(&$sandbox = NULL) {
  $database = \Drupal::database();
  $entity_type_manager = \Drupal::entityTypeManager();
  $membership_storage = $entity_type_manager->getStorage('group_relationship');

  if (!isset($sandbox['initialized'])) {
    $sandbox['initialized'] = TRUE;
    $sandbox['processed'] = 0;
    $sandbox['current_id'] = 0;
    $sandbox['fixed'] = 0;
    $sandbox['missing_group'] = 0;
    $sandbox['missing_role'] = 0;

    $sandbox['total'] = (int) $database->select('group_relationship_field_data', 'grfd')
      ->condition('grfd.plugin_id', 'group_membership')
      ->countQuery()
      ->execute()
      ->fetchField();
  }

  $query = $database->select('group_relationship_field_data', 'grfd');
  $query->fields('grfd', ['id', 'gid', 'type']);
  $query->condition('grfd.plugin_id', 'group_membership');
  $query->condition('grfd.id', $sandbox['current_id'], '>');
  $query->orderBy('grfd.id', 'ASC');
  $query->range(0, 50);
  $memberships = $query->execute()->fetchAllAssoc('id');

  if (empty($memberships)) {
    $sandbox['#finished'] = 1;
    return t('Backfilled @fixed missing group membership role assignments. Skipped @missing_group memberships with missing groups and @missing_role memberships with no default role.', [
      '@fixed' => $sandbox['fixed'],
      '@missing_group' => $sandbox['missing_group'],
      '@missing_role' => $sandbox['missing_role'],
    ]);
  }

  foreach ($memberships as $membership_id => $membership_row) {
    $sandbox['current_id'] = (int) $membership_id;
    $sandbox['processed']++;

    $existing_role = $database->select('group_relationship__group_roles', 'grgr')
      ->fields('grgr', ['group_roles_target_id'])
      ->condition('grgr.entity_id', $membership_id)
      ->range(0, 1)
      ->execute()
      ->fetchField();

    if ($existing_role) {
      continue;
    }

    $membership = $membership_storage->load($membership_id);
    if (!$membership) {
      continue;
    }

    $group = $membership->getGroup();
    if (!$group) {
      $sandbox['missing_group']++;
      continue;
    }

    $role_id = $group->bundle() . '-member';
    $role = $entity_type_manager->getStorage('group_role')->load($role_id);
    if (!$role) {
      $sandbox['missing_role']++;
      continue;
    }

    $membership->addRole($role_id);
    $membership->save();
    $sandbox['fixed']++;
  }

  if (!empty($sandbox['total'])) {
    $sandbox['#finished'] = min($sandbox['processed'] / $sandbox['total'], 1);
  }
  else {
    $sandbox['#finished'] = 1;
  }
}
