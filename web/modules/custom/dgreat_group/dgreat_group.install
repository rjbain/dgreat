<?php

/**
 * @file
 * Update hooks for the dgreat_group module.
 */

/**
 * Marks upgraded Group relationship type IDs as legacy-compatible.
 */
function dgreat_group_update_8101() {
  \Drupal::state()->set('group_update_10300_detected_legacy_version', TRUE);

  return t('Enabled legacy Group relationship type ID lookups for upgraded group content plugins.');
}

/**
 * Repairs partially migrated Group 3 schema metadata after Drupal 10 upgrades.
 */
function dgreat_group_update_8102() {
  $database = \Drupal::database();
  $schema = $database->schema();
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_field_manager = \Drupal::service('entity_field.manager');
  $last_installed_schema_repository = \Drupal::service('entity.last_installed_schema.repository');
  $storage_schema = \Drupal::keyValue('entity.storage_schema.sql');

  if ($schema->tableExists('group_content') && !$schema->tableExists('group_relationship')) {
    $schema->renameTable('group_content', 'group_relationship');
  }

  if ($schema->tableExists('group_content_field_data') && !$schema->tableExists('group_relationship_field_data')) {
    $schema->renameTable('group_content_field_data', 'group_relationship_field_data');
  }

  if ($storage_schema->has('group_content.entity_schema_data') && !$storage_schema->has('group_relationship.entity_schema_data')) {
    $storage_schema->set('group_relationship.entity_schema_data', $storage_schema->get('group_content.entity_schema_data'));
  }

  foreach ($storage_schema->getAll() as $key => $value) {
    if (str_starts_with($key, 'group_content.field_schema_data.')) {
      $new_key = str_replace('group_content.field_schema_data.', 'group_relationship.field_schema_data.', $key);
      if (!$storage_schema->has($new_key)) {
        $storage_schema->set($new_key, $value);
      }
      $storage_schema->delete($key);
    }
  }

  $storage_schema->delete('group_content.entity_schema_data');

  $last_installed_schema_repository->setLastInstalledDefinition($entity_type_manager->getDefinition('group_relationship'));
  $last_installed_schema_repository->setLastInstalledDefinition($entity_type_manager->getDefinition('group_relationship_type'));
  $last_installed_schema_repository->setLastInstalledDefinition($entity_type_manager->getDefinition('group_config_wrapper'));
  $last_installed_schema_repository->setLastInstalledFieldStorageDefinitions('group_relationship', $entity_field_manager->getFieldStorageDefinitions('group_relationship'));
  $last_installed_schema_repository->deleteLastInstalledDefinition('group_content');
  $last_installed_schema_repository->deleteLastInstalledDefinition('group_content_type');

  \Drupal::state()->set('group_update_10300_detected_legacy_version', FALSE);

  return t('Repaired Group relationship schema tables and installed entity metadata after a partial upgrade.');
}

/**
 * Restores Group 3 denormalized relationship columns after partial upgrades.
 */
function dgreat_group_update_8103() {
  $database = \Drupal::database();
  $schema = $database->schema();

  if (!$schema->tableExists('group_relationship_field_data')) {
    return t('Skipped Group relationship column repair because the data table does not exist yet.');
  }

  if (!$schema->fieldExists('group_relationship_field_data', 'plugin_id')) {
    $schema->addField('group_relationship_field_data', 'plugin_id', [
      'type' => 'varchar',
      'length' => 64,
      'not null' => FALSE,
      'description' => 'The Group relation plugin ID.',
    ]);
  }

  if (!$schema->fieldExists('group_relationship_field_data', 'group_type')) {
    $schema->addField('group_relationship_field_data', 'group_type', [
      'type' => 'varchar_ascii',
      'length' => 32,
      'not null' => FALSE,
      'description' => 'The ID of the parent group type.',
    ]);
  }

  $relationship_types = \Drupal::entityTypeManager()
    ->getStorage('group_relationship_type')
    ->loadMultiple();

  foreach ($relationship_types as $relationship_type) {
    $database->update('group_relationship_field_data')
      ->fields([
        'plugin_id' => $relationship_type->getPluginId(),
        'group_type' => $relationship_type->getGroupTypeId(),
      ])
      ->condition('type', $relationship_type->id())
      ->execute();
  }

  $schema->changeField('group_relationship_field_data', 'plugin_id', 'plugin_id', [
    'type' => 'varchar',
    'length' => 64,
    'not null' => TRUE,
    'description' => 'The Group relation plugin ID.',
  ]);

  $schema->changeField('group_relationship_field_data', 'group_type', 'group_type', [
    'type' => 'varchar_ascii',
    'length' => 32,
    'not null' => TRUE,
    'description' => 'The ID of the parent group type.',
  ]);

  if (!$schema->indexExists('group_relationship_field_data', 'group_relationship__load_by_group')) {
    $database->query('CREATE INDEX group_relationship__load_by_group ON {group_relationship_field_data} (gid, plugin_id, entity_id)');
  }

  if (!$schema->indexExists('group_relationship_field_data', 'group_relationship__load_by_entity')) {
    $database->query('CREATE INDEX group_relationship__load_by_entity ON {group_relationship_field_data} (entity_id, plugin_id)');
  }

  if (!$schema->indexExists('group_relationship_field_data', 'group_relationship__load_by_plugin')) {
    $database->query('CREATE INDEX group_relationship__load_by_plugin ON {group_relationship_field_data} (plugin_id)');
  }

  if (!$schema->indexExists('group_relationship_field_data', 'group_relationship__sync_scope_checks')) {
    $database->query('CREATE INDEX group_relationship__sync_scope_checks ON {group_relationship_field_data} (group_type, plugin_id)');
  }

  return t('Repaired Group relationship plugin and group type columns after a partial upgrade.');
}
