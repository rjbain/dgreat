{#
/**
 * @file
 * Theme override to display a news teaser row as a Bootstrap card.
 *
 * @see template_preprocess_views_view_fields()
 */
#}
{% set image_url = fields.field_image_url.content|striptags|trim %}
{% set body = row._entity.body.value %}

<div class="card">
    {% if image_url %}
        <img alt="" class="card-img-top" src="{{ 'https://www.usfca.edu' ~ image_url }}" />
    {% endif %}
    <div class="card-body">
        <h5 class="card-title">{{ fields.title.content }}</h5>
        <div class="card-text">{{ body|raw }}</div>
    </div>
</div>
