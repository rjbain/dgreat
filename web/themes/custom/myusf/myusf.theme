<?php
use \Drupal\block_content\BlockContentInterface;
use Drupal\Core\Link;
use Drupal\Core\Url;
use Drupal\Component\Utility\Html;
use Drupal\Core\Render\Markup;
use \Drupal\paragraphs\Entity\Paragraph;

/**
 * @file
 */

/**
 *
 */
function myusf_preprocess(&$variables) {
  isset($_GET["search_content"]) ? $search_content = $_GET["search_content"] : $search_content = "";
  isset($_GET["event_category"]) ? $event_category = $_GET["event_category"] : $event_category = "";
  isset($_GET["event_date"]) ? $event_date = $_GET["event_date"] : $event_date = "";
  isset($_GET["event_target"]) ? $event_target = $_GET["event_target"] : $event_target = "";
  isset($_GET["action"]) ? $action = $_GET["action"] : $action = "";
  isset($_GET["usfca_search"]) ? $usfca_search = $_GET["usfca_search"] : $usfca_search = "";
  isset($_GET["myusf_search"]) ? $myusf_search = $_GET["myusf_search"] : $myusf_search = "";

  $variables['search_content'] = htmlentities($search_content, ENT_QUOTES | ENT_HTML5, 'UTF-8');
  $variables['event_category'] = htmlentities($event_category, ENT_QUOTES | ENT_HTML5, 'UTF-8');
  $variables['event_date'] = htmlentities($event_date, ENT_QUOTES | ENT_HTML5, 'UTF-8');
  $variables['event_target'] = htmlentities($event_target, ENT_QUOTES | ENT_HTML5, 'UTF-8');
  $variables['action'] = htmlentities($action, ENT_QUOTES | ENT_HTML5, 'UTF-8');
  $variables['usfca_search'] = htmlentities($usfca_search, ENT_QUOTES | ENT_HTML5, 'UTF-8');
  $variables['myusf_search'] = htmlentities($myusf_search, ENT_QUOTES | ENT_HTML5, 'UTF-8');
}

/**
 * Implements hook_preprocess_HOOK() for block.html.twig.
 */
function myusf_preprocess_block(&$vars) {
  if ($vars['derivative_plugin_id'] == 'search_results') {
    $vars['#cache']['max-age'] = 0;
  }

  if ($vars['derivative_plugin_id'] == 'event_search') {
    $vars['#cache']['max-age'] = 0;
  }

  if ($vars['derivative_plugin_id'] == 'user_block') {
    $vars['#cache']['max-age'] = 0;
  }

  if ($vars['derivative_plugin_id'] == 'user_block_dashboard') {
    $vars['#cache']['max-age'] = 0;
  }

  // Allow blocks to update after editing.
  if ($vars['base_plugin_id'] == 'block_content') {
    $renderer = \Drupal::service('renderer');
    $renderer->addCacheableDependency($vars, $vars['content']['#block_content']);
  }

    // Get email address fields in contact boxes and add markup to them so they will wrap lines when they're too long.
    $content = $vars['elements']['content'];
    if (isset($content['#block_content']) && $content['#block_content'] instanceof BlockContentInterface) {
        $blockType = $content['#block_content']->bundle();

        if ($blockType === 'contact') {
            $addys = $content['#block_content']->get('field_email_address');
            if (!empty($addys[0]->value)) {
                $vars['altered_email_address1'] = html_entity_decode(str_replace("@", "<wbr>@", $addys[0]->value));
            }
            if (!empty($addys[1]->value)) {
                $vars['altered_email_address2'] = html_entity_decode(str_replace("@", "<wbr>@", $addys[1]->value));
            }
        }

    }

    $node = \Drupal::routeMatch()->getParameter('node');
    if ($node instanceof \Drupal\node\NodeInterface) {
      $vars["nid"] = $node->id();
    }    
}


function myusf_theme_suggestions_block_alter(&$suggestions, $variables) {
  $content = $variables['elements']['content'];
  if (isset($content['#block_content']) && $content['#block_content'] instanceof \Drupal\block_content\BlockContentInterface) {
    $suggestions[] = 'block__type__' . $content['#block_content']->bundle();
  }
}



/**
 * Implements hook_theme_suggestions_HOOK_alter().
 */
function myusf_theme_suggestions_page_alter(&$suggestions, $variables, $hook) {
  /**
     * 404 template suggestion.
     */
  if (!is_null(Drupal::requestStack()->getCurrentRequest()->attributes->get('exception'))) {
    $status_code = Drupal::requestStack()->getCurrentRequest()->attributes->get('exception')->getStatusCode();
    switch ($status_code) {
      case 404:{
        $suggestions[] = 'page__' . (string) $status_code;
        break;
}
      default:
        break;
    }
  }
}

/**
 * Implements template_preprocess_paragraph().
 *
 * @param array $variables
 *   An associative array containing:
 *   - elements: An array of elements to display in view mode.
 *   - paragraph: The paragraph object.
 *   - view_mode: View mode; e.g., 'full', 'teaser'...
 */

function myusf_preprocess_paragraph__video(&$variables) {
    $variables['new_vid_url'] = '';

    if (empty($variables['paragraph']->field_video_url[0]->uri)) {
        return;
    }

    $original_video_url = trim($variables['paragraph']->field_video_url[0]->uri);

    if ($original_video_url === '') {
        return;
    }

    // Is it a youtube link?
    if (strpos($original_video_url, 'youtu') !== false) {
        $youtube_id = '';
        $parts = parse_url($original_video_url);

        if (!empty($parts['host']) && strpos($parts['host'], 'youtu.be') !== false && !empty($parts['path'])) {
            $youtube_id = trim($parts['path'], '/');
        }
        elseif (!empty($parts['query'])) {
            parse_str($parts['query'], $query);
            if (!empty($query['v']) && is_scalar($query['v'])) {
                $youtube_id = $query['v'];
            }
        }

        if (!$youtube_id) {
            $youtube_preg = preg_match("/(?:youtu\.be\/|youtube\.com\/(?:(?:embed|v|vi|shorts)\/|.*[?&]v=))([^\?&\"'>\/]+)/", $original_video_url, $matches);
            if ($youtube_preg > 0 && !empty($matches[1])) {
                $youtube_id = $matches[1];
            }
        }

        if ($youtube_id) {
            $variables['new_vid_url'] = 'https://www.youtube.com/embed/' . $youtube_id;
            return;
        }
    }
    elseif (strpos($original_video_url, 'vimeo') !== false) {
        $vimeo_preg = preg_match('/(https?:\/\/)?(www\.)?(player\.)?vimeo\.com\/([a-z]*\/)*([0-9]{6,11})[?]?.*/', $original_video_url, $matches);
        if ($vimeo_preg > 0 && !empty($matches[5])) {
            $vimeo_id = $matches[5];
            $variables['new_vid_url'] = 'https://player.vimeo.com/video/' . $vimeo_id;
            return;
        }
    }
    elseif (strpos($original_video_url, 'panopto') !== false) {
        $variables['new_vid_url'] = $original_video_url;
        return;
    }

    $variables['new_vid_url'] = $original_video_url;
}


function myusf_preprocess_node(&$variables)
{
    // Check for a video on the page.
    // Need this for knowing when to print out the modal overlay markup.
    $node = $variables['node'];
    $paragraph_video_exists = FALSE;
    if ($node->hasField('field_migrate_final')) {
        // Get the referenced entities for the "body" field, aka field_migrate_final.
        $paragraphs = $node->field_migrate_final->referencedEntities();
        // Search through entities and nested entities for the video url field.
        foreach ($paragraphs as $paragraph) {
            if (isset($paragraph->field_video_url[0]->uri)) {
                $paragraph_video_exists = true;
            }
            foreach ($paragraph->referencedEntities() as $nested) {
                if (isset($nested->field_video_url[0]->uri)) {
                    $paragraph_video_exists = true;
                }
                foreach ($nested->referencedEntities() as $buried) {
                    if (isset($buried->field_video_url[0]->uri)) {
                        $paragraph_video_exists = true;
                    }
                    foreach ($buried->referencedEntities() as $carbonite) {
                        if (isset($carbonite->field_video_url[0]->uri)) {
                            $paragraph_video_exists = true;
                        }
                    }
                }
            }
        }
    }
    $variables['paragraph_video_exists'] = $paragraph_video_exists;


  // Allowed view modes
  // For checking the hero image region and allowing access to it from the node template so that titles can be handled accordingly
  $view_mode = $variables['view_mode']; // Retrieve view mode
  $allowed_view_modes = ['full']; // Array of allowed view modes (for performance so as to not execute on unneeded nodes)
  // If view mode is in allowed view modes list, pass to myusf_add_regions_to_node()
  if(in_array($view_mode, $allowed_view_modes)) {
    // Allowed regions (for performance so as to not execute for unneeded region)
    $allowed_regions = ['hero_image'];
    myusf_add_regions_to_node($allowed_regions, $variables);
  }

}

/**
 * Implements hook_preprocess_views_view().
 */
function myusf_preprocess_views_view(&$variables) {
  $variables['selected_event_category_tags'] = [];
  $variables['clear_all_event_category_url'] = NULL;

  if ($variables['id'] === 'events_search') {
    $tag_data = myusf_build_selected_event_category_tags();
    $variables['selected_event_category_tags'] = $tag_data['tags'];
    $variables['clear_all_event_category_url'] = $tag_data['clear_all_url'];
    $variables['#cache']['contexts'][] = 'url.query_args';
    $variables['#cache']['contexts'][] = 'url.path';
  }
}

/**
 * Implements hook_preprocess_views_view_unformatted().
 */
function myusf_preprocess_views_view_unformatted(array &$variables) {
  if (($variables['view']->id() ?? NULL) !== 'sitewide_search') {
    return;
  }

  $total_rows = (int) ($variables['view']->total_rows ?? 0);
  $variables['sitewide_search_results_count_text'] = $total_rows === 1
    ? '1 result'
    : $total_rows . ' results';
}

/**
 * Implements hook_theme_suggestions_views_view_fields_alter().
 */
function myusf_theme_suggestions_views_view_fields_alter(array &$suggestions, array $variables) {
  if (($variables['view']->id() ?? NULL) === 'sitewide_search') {
    $suggestions[] = 'views_view_fields__sitewide_search';
  }
}

/**
 * Implements hook_preprocess_views_view_fields().
 */
function myusf_preprocess_views_view_fields(array &$variables) {
  if (($variables['view']->id() ?? NULL) !== 'sitewide_search') {
    return;
  }

  $variables['result_path_breadcrumb'] = [];
  $variables['result_path_breadcrumb_text'] = '';
  $variables['cleaned_summary'] = '';
  $variables['result_title'] = '';
  $variables['result_title_markup'] = '';
  $variables['result_url'] = '';
  $search_keywords = myusf_get_sitewide_search_keywords();

  if (!empty($variables['fields']['field_display_title']->content)) {
    $variables['result_title_markup'] = $variables['fields']['field_display_title']->content;
    $variables['result_title'] = trim(strip_tags((string) $variables['fields']['field_display_title']->content));
  }
  elseif (!empty($variables['fields']['media_name']->content)) {
    $variables['result_title_markup'] = $variables['fields']['media_name']->content;
    $variables['result_title'] = trim(strip_tags((string) $variables['fields']['media_name']->content));
  }

  if (!empty($variables['fields']['field_migrate_final']->content)) {
    $variables['cleaned_summary'] = myusf_clean_search_result_summary($variables['fields']['field_migrate_final']->content, $search_keywords);
  }
  elseif (!empty($variables['fields']['media_document_filename']->content)) {
    $variables['cleaned_summary'] = myusf_clean_search_result_summary($variables['fields']['media_document_filename']->content, $search_keywords);
  }

  $item = $variables['row']->_item ?? NULL;
  if (!$item || !$item->getOriginalObject()) {
    return;
  }

  $original = $item->getOriginalObject()->getValue();
  if (!$original || !method_exists($original, 'toUrl')) {
    return;
  }

  try {
    if ($original instanceof \Drupal\media\MediaInterface && $original->bundle() === 'document' && $original->hasField('field_media_document') && !$original->get('field_media_document')->isEmpty()) {
      $file = $original->get('field_media_document')->entity;
      if ($file) {
        $url = \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
        $variables['result_title_markup'] = '<a href="' . htmlspecialchars($url, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '">' . htmlspecialchars($variables['result_title'], ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8') . '</a>';
      }
    }

    if (empty($url)) {
      $url = $original->toUrl('canonical')->toString();
    }
  }
  catch (\Exception $exception) {
    return;
  }

  $variables['result_url'] = $url;
  $path = parse_url($url, PHP_URL_PATH) ?: '';
  $host = 'myusf.usfca.edu';
  $segments = array_values(array_filter(explode('/', trim($path, '/')), static function ($segment) {
    return $segment !== '';
  }));

  if (!$segments) {
    $variables['result_path_breadcrumb_text'] = $host;
    return;
  }

  $variables['result_path_breadcrumb'] = $segments;
  $variables['result_path_breadcrumb_text'] = $host . ' > ' . implode(' > ', $segments);
}

/**
 * Normalizes the sitewide search summary snippet for cleaner display.
 */
function myusf_clean_search_result_summary($summary, array $search_keywords = []) {
  $summary = html_entity_decode((string) $summary, ENT_QUOTES | ENT_HTML5, 'UTF-8');
  $summary = trim(strip_tags($summary));
  $summary = preg_replace('/\s+/u', ' ', $summary) ?? '';
  $summary = ltrim($summary, " \t\n\r\0\x0B'\"`.,;:-");

  if ($summary === '') {
    return '';
  }

  $first_character = mb_substr($summary, 0, 1);
  $remaining_summary = mb_substr($summary, 1);
  $summary = mb_strtoupper($first_character) . $remaining_summary;
  $summary = myusf_truncate_search_result_summary($summary, 250);

  return myusf_highlight_search_keywords($summary, $search_keywords);
}

/**
 * Truncates a search result summary to a fixed character length.
 */
function myusf_truncate_search_result_summary($summary, $max_length = 250) {
  $summary = trim((string) $summary);
  $max_length = (int) $max_length;

  if ($summary === '' || $max_length <= 0) {
    return '';
  }

  if (mb_strlen($summary) <= $max_length) {
    return $summary;
  }

  $truncated_summary = mb_substr($summary, 0, $max_length + 1);
  $last_space_position = mb_strrpos($truncated_summary, ' ');

  if ($last_space_position !== FALSE && $last_space_position > (int) floor($max_length * 0.6)) {
    $truncated_summary = mb_substr($truncated_summary, 0, $last_space_position);
  }
  else {
    $truncated_summary = mb_substr($truncated_summary, 0, $max_length);
  }

  return rtrim($truncated_summary, " \t\n\r\0\x0B,;:-") . '...';
}

/**
 * Gets the current sitewide search keywords.
 */
function myusf_get_sitewide_search_keywords() {
  $query = \Drupal::request()->query->get('search_api_fulltext');
  if (!is_string($query) || trim($query) === '') {
    return [];
  }

  preg_match_all('/"[^"]+"|\S+/', $query, $matches);
  $keywords = [];

  foreach ($matches[0] ?? [] as $keyword) {
    $keyword = trim($keyword, " \t\n\r\0\x0B\"");
    if ($keyword !== '') {
      $keywords[] = $keyword;
    }
  }

  return array_values(array_unique($keywords));
}

/**
 * Highlights search keywords in the rendered summary snippet.
 */
function myusf_highlight_search_keywords($summary, array $search_keywords = []) {
  $escaped_summary = Html::escape($summary);
  if (!$search_keywords) {
    return $escaped_summary;
  }

  usort($search_keywords, static function ($a, $b) {
    return mb_strlen($b) <=> mb_strlen($a);
  });

  $pattern_parts = [];
  foreach ($search_keywords as $keyword) {
    $pattern_parts[] = preg_quote(Html::escape($keyword), '/');
  }

  if (!$pattern_parts) {
    return $escaped_summary;
  }

  $highlighted_summary = preg_replace(
    '/' . implode('|', $pattern_parts) . '/iu',
    '<strong>$0</strong>',
    $escaped_summary
  );

  return Markup::create($highlighted_summary ?? $escaped_summary);
}

/**
 * Builds selected event category tags from the current query string.
 */
function myusf_build_selected_event_category_tags() {
  $request = \Drupal::request();
  $category_filters = $request->query->all('field_category');
  $category_ids = [];
  $default_student_events_id = 2461;
  $is_student_events_page = \Drupal::service('path_alias.manager')->getAliasByPath($request->getPathInfo()) === '/calendar/student-events';
  $base_path = $is_student_events_page ? '/calendar' : $request->getPathInfo();

  if (is_array($category_filters)) {
    foreach ($category_filters as $value) {
      if (is_scalar($value) && ctype_digit((string) $value)) {
        $category_ids[] = (int) $value;
      }
    }
  }

  $category_ids = array_values(array_unique($category_ids));
  if (!$category_ids && $is_student_events_page) {
    $category_ids = [$default_student_events_id];
  }

  if (!$category_ids) {
    return [
      'tags' => [],
      'clear_all_url' => NULL,
    ];
  }

  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadMultiple($category_ids);
  $current_query = $request->query->all();
  $tags = [];

  foreach ($category_ids as $category_id) {
    if (empty($terms[$category_id])) {
      continue;
    }

    $label_query = $current_query;
    $label_query['field_category'] = [
      $category_id => $category_id,
    ];
    $label_url = Url::fromUserInput($base_path, ['query' => $label_query]);
    $link_text = ($is_student_events_page && $category_id === $default_student_events_id)
      ? 'Student Events'
      : $terms[$category_id]->label();
    $remove_query = $current_query;

    if (isset($remove_query['field_category']) && is_array($remove_query['field_category'])) {
      unset($remove_query['field_category'][$category_id]);
      if (!$remove_query['field_category']) {
        unset($remove_query['field_category']);
      }
    }

    $remove_url = Url::fromUserInput($base_path, ['query' => $remove_query]);

    $tags[] = [
      'label' => $link_text,
      'label_link' => Link::fromTextAndUrl($link_text, $label_url)->toRenderable(),
      'remove_url' => $remove_url->toString(),
    ];
  }

  return [
    'tags' => $tags,
    'clear_all_url' => Url::fromUserInput($base_path)->toString(),
  ];
}

/**
* myusf_add_regions_to_node
*/

function myusf_add_regions_to_node($allowed_regions, &$variables) {
  // Retrieve active theme
  $theme = \Drupal::theme()->getActiveTheme()->getName();

  // Retrieve theme regions
  $available_regions = system_region_list($theme, 'REGIONS_ALL');

  // Validate allowed regions with available regions
  $regions = array_intersect(array_keys($available_regions), $allowed_regions);

  // For each region
  foreach ($regions as $key => $region) {

    // Load region blocks
    $blocks = \Drupal::entityTypeManager()->getStorage('block')->loadByProperties(array('theme' => $theme, 'region' => $region));

    // Sort ‘em
    uasort($blocks, 'Drupal\block\Entity\Block::sort');

    // Capture viewable blocks and their settings to $build
    $build = array();
    $builder = \Drupal::entityTypeManager()->getViewBuilder('block');
    foreach ($blocks as $key => $block) {
      if ($block->access('view')) {
        $build[$key] = $builder->view($block, 'block');
      }
    }
    // Add build to region
    $variables[$region] = $build;
  }
}


/**
 * Implements hook_page_attachments_alter().
 */
function myusf_page_attachments_alter(array &$attachments, $variables) {

    $node = \Drupal::request()->get('node');
    $type = "";

    if (isset($node) && $node instanceof \Drupal\node\NodeInterface) {
        $type = $node->getType();
    }

    // We want to prevent the search engines from indexing favorite_link content.
    if ($type == 'favorite_link') {
        // add the metatag
        $newtag = [
            '#tag' => 'meta',
            '#attributes' => [
                'name' => 'robots',
                'content' => 'noindex, nofollow',
            ],
        ];
        $attachments['#attached']['html_head'][] = [$newtag, 'robots'];
    }
}
