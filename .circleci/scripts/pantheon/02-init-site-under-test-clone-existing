#!/bin/bash

set -eo pipefail

# Print each command before executing for easier CI log diagnosis
set -x

#
# This script prepares the site-under-test by cloning the database from
# an existing site.
#
# Use EITHER this script OR the re-install-new script; do not run both.
#

# Create a new multidev site to test on
terminus -n env:wake "$TERMINUS_SITE.dev"
terminus -n build:env:create "$TERMINUS_SITE.dev" "$TERMINUS_ENV" --yes --notify="$NOTIFY"

# flexible_permissions must be registered in core.extension BEFORE any drush
# command that bootstraps Drupal.  drush pm-enable itself bootstraps and hits
# the same "non-existent service" container error, so we fix at DB level.
#
# drush sql:query only needs a DB connection (bootstrap level 4), not the full
# service container, so it works even when the container is broken.
# We capture raw SQL output to a file; terminus/drush may prepend a column-name
# header row ("data") or other lines, so PHP scans all lines for the serialized
# blob rather than relying on grep (which would exit 1 under pipefail if the
# blob line didn't appear first).
terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- sql:query \
  "SELECT data FROM config WHERE name='core.extension'" \
  > /tmp/core_ext_raw.txt 2>&1 || true
# Note: 2>&1 captures both stdout and stderr into the file. On Pantheon,
# terminus may route the SQL result through stderr rather than stdout.
# PHP below filters for the serialized blob regardless of surrounding noise.

UPDATE_SQL=$(php << 'PHPEOF'
<?php
$raw = file_get_contents('/tmp/core_ext_raw.txt');
// Find the first line that looks like a serialized PHP array/string.
$blob = '';
foreach (explode("\n", $raw) as $line) {
    $line = trim($line);
    if (preg_match('/^[asbidOC]:\d+/', $line)) {
        $blob = $line;
        break;
    }
}
if (!$blob) {
    fwrite(STDERR, "core.extension blob not found in SQL output — skipping.\n");
    exit(0);
}
$d = @unserialize($blob);
if (!is_array($d) || !isset($d['module'])) {
    fwrite(STDERR, "core.extension could not be unserialized — skipping.\n");
    exit(0);
}
if (array_key_exists('flexible_permissions', $d['module'])) {
    fwrite(STDERR, "flexible_permissions already in core.extension, skipping.\n");
    exit(0);
}
$d['module']['flexible_permissions'] = 0;
ksort($d['module']);
// UNHEX avoids every SQL-escaping concern with the serialized PHP blob.
echo "UPDATE config SET data=UNHEX('" . bin2hex(serialize($d)) . "') WHERE name='core.extension';";
PHPEOF
)

if [[ "$UPDATE_SQL" == UPDATE* ]]; then
  terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- sql:query "$UPDATE_SQL"
  echo "flexible_permissions registered in core.extension."
else
  echo "flexible_permissions injection skipped (already present or blob not found)."
fi

# Truncate cache_container BEFORE drush cr. After a Drupal major-version upgrade
# (e.g. D10 → D11) the compiled service container cached in cache_container is
# built against the old core and will fatal on boot (e.g. MemoryBackend::__construct
# argument count change). drush cr cannot self-bootstrap to fix this, so we must
# clear it at the SQL level first.
terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- sql:query "TRUNCATE cache_container;" || true

# Clear caches BEFORE updatedb so stale entity type handler class names from
# the cloned DB (e.g. Group 1.x class names) are flushed before update hooks
# run. Without this, group_update_10300 fails with
# "Class name must be a valid object or a string".
terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" cr

# Run updatedb to ensure that the cloned database is updated for the new code.
# --no-cache-clear avoids a second bootstrap cycle; we clear caches explicitly below.
terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- updatedb --yes --no-cache-clear
echo "updatedb exit code: $?"

# If any modules, or theme files have been moved around or reorganized, in order to avoid
# "The website encountered an unexpected error. Please try again later." error on First Visit
terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" cr

# If exported configuration is available, then import it.
if [ -f "config/system.site.yml" ] ; then
  # Run config-import up to 2 times; a second pass resolves ordering issues where
  # one import creates entities another config depends on.
  terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- config-import --yes \
    && echo "config-import succeeded on first pass." \
    || { echo "config-import FAILED on first pass — retrying..."; \
         terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- config-import --yes; }
fi
