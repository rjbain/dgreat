#!/bin/bash

set -eo pipefail
set -x

terminus -n env:wake "$TERMINUS_SITE.dev"
terminus -n build:env:create "$TERMINUS_SITE.dev" "$TERMINUS_ENV" --yes --notify="$NOTIFY"

terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- updatedb --yes || true
echo "updatedb attempted."

terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" cr || true

if [ -f "config/system.site.yml" ] ; then
  CONFIG_TABLE_CHECK=$(terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- sql:query "SHOW TABLES LIKE 'config';" 2>/dev/null || true)

  if [[ "$CONFIG_TABLE_CHECK" == *config* ]]; then
    echo "Config table exists; proceeding with config cleanup/import."

    terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- sql:query "
      DELETE FROM config WHERE name LIKE 'block.block.adminimal_theme_%';
      DELETE FROM config WHERE name LIKE 'block.block.seven_%';
      DELETE FROM config WHERE name LIKE 'tour.tour.%';
      DELETE FROM config WHERE name LIKE 'core.entity_view_mode.tour.%';
      DELETE FROM config WHERE name = 'adminimal_theme.settings';
      DELETE FROM config WHERE name = 'seven.settings';
      DELETE FROM config WHERE name = 'editor.editor.full_html';
    " || true

    terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- sql:query \
      "SELECT HEX(data) FROM config WHERE name='core.extension'" \
      > /tmp/core_ext_raw2.txt 2>&1 || true

    CLEAN_SQL=$(php << 'PHPEOF'
<?php
$raw = file_get_contents('/tmp/core_ext_raw2.txt');
if (!preg_match('/([0-9A-F]{100,})/i', $raw, $matches)) {
    exit(0);
}
$hex = $matches[1];
$blob = @hex2bin($hex);
if ($blob === false) { exit(0); }
$d = @unserialize($blob);
if (!is_array($d)) { exit(0); }
$remove_modules = ['ckeditor','jquery_ui_slider','jquery_ui_touch_punch','tour',
                   'webform_location_geocomplete','webform_toggles'];
$remove_themes  = ['seven','adminimal_theme'];
$changed = FALSE;
foreach ($remove_modules as $m) {
    if (isset($d['module'][$m])) { unset($d['module'][$m]); $changed = TRUE; }
}
foreach ($remove_themes as $t) {
    if (isset($d['theme'][$t])) { unset($d['theme'][$t]); $changed = TRUE; }
}
if (!$changed) { exit(0); }
echo "UPDATE config SET data=UNHEX('" . bin2hex(serialize($d)) . "') WHERE name='core.extension';";
PHPEOF
    )

    if [[ "$CLEAN_SQL" == UPDATE* ]]; then
      terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- sql:query "$CLEAN_SQL"
      echo "Removed non-existent modules/themes from core.extension in DB."
    fi

    terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- config-import --yes \
      && echo "config-import succeeded on first pass." \
      || { echo "config-import FAILED on first pass — retrying..."; \
           terminus -n drush "$TERMINUS_SITE.$TERMINUS_ENV" -- config-import --yes; }
  else
    echo "Config table missing; skipping config cleanup/import."
  fi
fi
